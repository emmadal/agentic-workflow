{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(pytest -q)",
      "Bash(python -m scripts.validate_skills)",
      "Bash(python -m scripts.sync_agents)",
      "Bash(python -m scripts.sync_agents --check)",
      "Bash(ruff check .)",
      "Bash(ruff format --check .)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline -20)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "ruff check . --quiet || true" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "pytest -q" }
        ]
      }
    ]
  }
}
